# Copy this file to .env.local and fill the values before running the API server

# Supabase project URL (ex: https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (used by frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key (admin, keep secret - used by api-server)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: custom API base for the Vite client
VITE_API_BASE=
 # Supabase (client) - público
 NEXT_PUBLIC_SUPABASE_URL=
 NEXT_PUBLIC_SUPABASE_ANON_KEY=

 # Supabase (server) - service role (NUNCA expor no cliente)
 SUPABASE_SERVICE_ROLE_KEY=

 # (Opcional) MongoDB URI de fallback
 MONGODB_URI=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
